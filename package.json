{
  "name": "tcdf-study-sqlite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-local-config.mjs",
    "predev": "node scripts/prepare-local-config.mjs",
    "dev": "node --import ./scripts/local-env.mjs ./node_modules/vinext/dist/cli.js dev --port 5173",
    "prebuild": "node scripts/prepare-local-config.mjs",
    "build": "node --import ./scripts/local-env.mjs ./node_modules/vinext/dist/cli.js build",
    "start": "node --import ./scripts/local-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import ./scripts/local-env.mjs ./node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local --config wrangler.local.json --persist-to .wrangler/state",
    "check:types": "node scripts/prepare-local-config.mjs && tsc --noEmit",
    "test:catalog": "node --experimental-strip-types scripts/test-study-catalog.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "prepare": "husky",
    "test:checkbox": "node scripts/test-study-checkbox.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fullcalendar/react": "^7.1.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.1",
    "simple-icons": "^16.33.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "temporal-polyfill": "^1.0.5",
    "topojson-client": "^3.1.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
